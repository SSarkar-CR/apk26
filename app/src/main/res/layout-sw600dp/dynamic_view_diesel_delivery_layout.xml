<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color_one"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/ll_item_fuelled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/margin_16"
        android:paddingEnd="@dimen/margin_16"
        android:paddingTop="@dimen/margin_12"
        android:paddingBottom="@dimen/margin_12"
        android:layout_marginTop="@dimen/margin_2"
        android:layout_marginBottom="@dimen/margin_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tv_item_fuelled"
            android:layout_weight="1.5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="*Item Fuelled :"
            android:layout_gravity="center_vertical"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_16sp"/>
        <EditText
            android:layout_weight="2"
            android:id="@+id/et_item_fulled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_background"
            android:padding="@dimen/margin_8"
            android:textSize="@dimen/text_size_16sp"
            android:textColor="@color/black_shade_three" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_item_plant_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/margin_16"
        android:paddingEnd="@dimen/margin_16"
        android:paddingTop="@dimen/margin_12"
        android:paddingBottom="@dimen/margin_12"
        android:layout_marginBottom="@dimen/margin_2"
        app:layout_constraintTop_toBottomOf="@+id/ll_item_fuelled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_weight="1.5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Item Plant Number :"
            android:layout_gravity="center_vertical"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_16sp"/>
        <EditText
            android:layout_weight="2"
            android:id="@+id/et_item_plant_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_background"
            android:padding="@dimen/margin_8"
            android:textSize="@dimen/text_size_16sp"
            android:textColor="@color/black_shade_three" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_liters_fuelled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/margin_16"
        android:paddingEnd="@dimen/margin_16"
        android:paddingTop="@dimen/margin_12"
        android:paddingBottom="@dimen/margin_12"
        android:layout_marginBottom="@dimen/margin_2"
        app:layout_constraintTop_toBottomOf="@+id/ll_item_plant_no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >
        <TextView
            android:layout_weight="1.5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="*Liters Fuelled :"
            android:layout_gravity="center_vertical"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_16sp"/>
        <EditText
            android:layout_weight="2"
            android:id="@+id/et_liters_fuelled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_background"
            android:padding="@dimen/margin_8"
            android:textSize="@dimen/text_size_16sp"
            android:inputType="numberDecimal"
            android:textColor="@color/black_shade_three" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_general_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/margin_16"
        android:paddingEnd="@dimen/margin_16"
        android:paddingTop="@dimen/margin_12"
        android:paddingBottom="@dimen/margin_12"
        android:layout_marginBottom="@dimen/margin_2"
        app:layout_constraintTop_toBottomOf="@+id/ll_liters_fuelled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_weight="1.5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="General Comment :"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_16sp"/>
        <EditText
            android:layout_weight="2"
            android:id="@+id/et_general_comment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_background"
            android:padding="@dimen/margin_8"
            android:textSize="@dimen/text_size_16sp"
            android:gravity="start"
            android:minLines="4"
            android:textColor="@color/black_shade_three" />
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_add_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="@dimen/margin_16"
        android:paddingEnd="@dimen/margin_16"
        android:paddingTop="@dimen/margin_12"
        android:paddingBottom="@dimen/margin_12"
        android:layout_marginTop="@dimen/margin_2"
        android:layout_marginBottom="@dimen/margin_2"
        app:layout_constraintTop_toBottomOf="@+id/ll_general_comment">
        <TextView
            android:layout_weight="1.5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add Item"
            android:gravity="center_vertical"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_add_item"
            android:layout_width="@dimen/margin_48"
            android:layout_height="@dimen/margin_48"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="0dp"
            android:foregroundGravity="center_vertical"
            android:background="@drawable/add"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>