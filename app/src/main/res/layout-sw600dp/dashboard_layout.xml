<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:fadingEdge="none"
    android:background="@color/white">
   <LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/footer_height">
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_1"
        android:background="@color/grey_shade_one"
        android:layout_marginBottom="@dimen/margin_8">
    </View>

   <TextView
       android:id="@+id/tv_last_refresh"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="Last refresh :"
       android:layout_marginBottom="@dimen/margin_8"
       android:textColor="@color/black_shade_two"
       android:textSize="@dimen/text_size_12sp"
       android:layout_marginStart="40dp"/>
       <View
           android:layout_width="match_parent"
           android:layout_height="@dimen/margin_1"
           android:background="@color/grey_shade_one"
           android:layout_marginBottom="@dimen/margin_16"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello,"
        android:textColor="@color/black_shade_two"
        android:textSize="@dimen/extra_small_text_size"
        android:layout_marginStart="40dp"/>
    <TextView
        android:id="@+id/tv_userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textStyle="bold"
        android:textColor="@color/black_shade_three"
        android:textSize="@dimen/extra_small_text_size"
        android:layout_marginStart="40dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

      <RelativeLayout
          android:id="@+id/rl_circular_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ProgressBar
            android:id="@+id/circularProgressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_alignParentTop="true"
            android:indeterminate="false"
            android:max="100"
            android:layout_centerInParent="true"
            android:progress="50"
            android:progressDrawable="@drawable/circular"
            android:secondaryProgress="100" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:layout_centerInParent="true"
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/black_shade_one" />
     </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_progress"
            android:layout_gravity="center"
            android:textColor="@color/black_shade_three"
            android:textSize="@dimen/small_text_size" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/margin_48"
        android:layout_marginStart="@dimen/margin_16"
        android:layout_marginEnd="@dimen/margin_16"
        android:background="@color/white">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_roadworthy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="@dimen/margin_8"
                android:background="@drawable/passed_inspections">
                <TextView
                    android:id="@+id/tv_roadworthy_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_16"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_36sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="Roadworthy \nVehicles"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/ll_defects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/open_defects">

                <TextView
                    android:id="@+id/tv_defects_count"
                    android:textSize="@dimen/text_size_36sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:textColor="@color/white"
                    android:layout_marginTop="@dimen/margin_16"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="0" />
                <TextView
                    android:textSize="@dimen/text_size_14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:layout_gravity="start"
                    android:text="Defect Vehicles"
                    android:layout_marginStart="@dimen/margin_16" />
            </LinearLayout>
         </LinearLayout>
    </LinearLayout>
       <Button
           android:id="@+id/bt_tasks"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="@dimen/margin_16"
           android:layout_marginStart="@dimen/margin_40"
           android:layout_marginEnd="@dimen/margin_40"
           android:gravity="start|center"
           android:background="@drawable/tasks_background"
           android:drawableLeft="@drawable/tasks"
           android:drawablePadding="@dimen/margin_8"
           android:text="Tasks"
           android:textAllCaps="false"
           android:textColor="@color/white"
           android:padding="@dimen/margin_24"
           android:textSize="@dimen/input_text_size"
           android:visibility="gone"/>
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Submitted Offline :"
           android:textColor="@color/black_shade_two"
           android:textSize="@dimen/extra_small_text_size"
           android:layout_marginStart="40dp"
           android:layout_marginTop="@dimen/margin_32"/>
       <TextView
           android:id="@+id/tv_synced"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="No Unsynced Forms."
           android:textColor="@color/black_shade_two"
           android:textSize="@dimen/text_size_16sp"
           android:layout_marginLeft="@dimen/margin_40"
           android:layout_marginRight="@dimen/margin_40"
           android:padding="@dimen/margin_12"
           android:background="@drawable/defects_details_bg"
           android:layout_marginTop="@dimen/margin_16"/>

       <androidx.recyclerview.widget.RecyclerView
           android:id="@+id/lv_unsync_forms"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginLeft="@dimen/margin_40"
           android:layout_marginRight="@dimen/margin_40"
           android:layout_marginTop="@dimen/margin_16"
           android:dividerHeight="@dimen/margin_4"
           android:fadingEdge="none"
           android:overScrollMode="never">
       </androidx.recyclerview.widget.RecyclerView>
   </LinearLayout>
</androidx.core.widget.NestedScrollView>
