<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/header_height_dashboard"
    android:background="@color/background_color_one"
    android:overScrollMode="never"
    android:fadingEdge="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/cl_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_dashboard"
            android:background="@color/white">

            <ImageView
                android:id="@+id/iv_cross"
                android:layout_width="@dimen/margin_20"
                android:layout_height="@dimen/margin_20"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_24"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/closed"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tv_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="34dp"
                android:text="Forms"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/small_text_size"
                android:textStyle="bold" />
        </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_inspect_asset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_24"
        android:layout_marginBottom="@dimen/margin_24"
        android:layout_marginStart="@dimen/margin_24"
        android:layout_marginEnd="@dimen/margin_24"
        android:background="@drawable/yellow_background_two">

        <TextView
            android:id="@+id/tv_inspect_asset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:drawableLeft="@drawable/content"
            android:drawablePadding="@dimen/margin_16"
            android:text="Inspect Asset"
            android:textColor="@color/black_shade_three"
            android:textSize="@dimen/text_size_16sp" />

        <ImageView
            android:id="@+id/iv_inspect_asset_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/arrow_black" />
    </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_search_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_24"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24"
            android:background="@drawable/green_background_two">

            <TextView
                android:id="@+id/tv_search_asset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/content"
                android:drawablePadding="@dimen/margin_16"
                android:text="Search for Asset"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />

            <ImageView
                android:id="@+id/iv_search_asset_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/arrow_black" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_new_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_24"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24"
            android:background="@drawable/blue_button_background_two">

            <TextView
                android:id="@+id/tv_new_asset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/content"
                android:drawablePadding="@dimen/margin_16"
                android:text="New Asset"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />

            <ImageView
                android:id="@+id/iv_new_asset_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/arrow_black" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_manage_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_24"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24"
            android:background="@drawable/red_background_two">

            <TextView
                android:id="@+id/tv_manage_asset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/content"
                android:drawablePadding="@dimen/margin_16"
                android:text="Manage Assets"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />

            <ImageView
                android:id="@+id/iv_manage_asset_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/arrow_black" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_my_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_24"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24"
            android:background="@drawable/purple_background_two">

            <TextView
                android:id="@+id/tv_my_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/content"
                android:drawablePadding="@dimen/margin_16"
                android:text="My Tasks"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />

            <ImageView
                android:id="@+id/iv_my_tasks_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/arrow_black" />
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
