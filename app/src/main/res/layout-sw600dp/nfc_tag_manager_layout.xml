<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color_one"
    android:orientation="vertical">
    <RelativeLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height_dashboard"
        android:background="@color/white">
        <ImageView
            android:id="@+id/iv_cross_nfc"
            android:layout_width="@dimen/margin_20"
            android:layout_height="@dimen/margin_20"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_24"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/closed"
            android:visibility="visible" />
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="34dp"
            android:layout_centerInParent="true"
            android:text="@string/nfc_tag_manager"
            android:textColor="@color/black_shade_five"
            android:textSize="@dimen/small_text_size"
            android:textStyle="bold"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:fadingEdge="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/rg_vehicle_trailer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24"
            android:layout_marginTop="@dimen/margin_12"
            android:orientation="horizontal"
            android:layout_below="@+id/tv_additional">

            <RadioButton
                android:id="@+id/rb_vehicle"
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle"
                android:textSize="@dimen/text_size_16sp"
                android:buttonTint="@color/blue_shade_one"
                android:textColor="@color/black_shade_two"
                android:layout_margin="@dimen/margin_8"/>
            <RadioButton
                android:id="@+id/rb_trailer"
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trailer"
                android:textSize="@dimen/text_size_16sp"
                android:buttonTint="@color/blue_shade_one"
                android:textColor="@color/black_shade_two"
                android:layout_margin="@dimen/margin_8"/>
        </RadioGroup>

       <com.crate.crateam.utility.CustomSearchableSpinner
        android:id="@+id/sp_vehicle_trailer_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spinner_bg"
        android:popupBackground="@color/white"
        android:paddingStart="@dimen/margin_24"
        android:paddingEnd="@dimen/margin_24"
        android:paddingTop="@dimen/margin_16"
        android:paddingBottom="@dimen/margin_16"
        android:dropDownVerticalOffset="100dp"
        android:theme="@style/spinnerTheme"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black_shade_two"
            android:text="@string/nfc_tag_manager_header"
            android:layout_margin="@dimen/margin_24"/>
        <LinearLayout
            android:id="@+id/ll_vehicle_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_shade_six"
                android:layout_marginBottom="@dimen/margin_12"/>
            <RadioGroup
                android:id="@+id/rg_vehicle_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/margin_16"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rb_front_tag"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/front_tag"
                    android:buttonTint="@color/blue_shade_one"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/black_shade_two"
                    android:layout_marginStart="@dimen/margin_16" />
                <RadioButton
                    android:id="@+id/rb_near_tag"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/near_tag"
                    android:buttonTint="@color/blue_shade_one"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/black_shade_two"
                    android:layout_marginStart="@dimen/margin_16" />
                <RadioButton
                    android:id="@+id/rb_off_tag"
                    android:layout_weight=".5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/off_tag"
                    android:buttonTint="@color/blue_shade_one"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/black_shade_two"
                    android:layout_marginStart="@dimen/margin_16" />
                <RadioButton
                    android:id="@+id/rb_completion_tag"
                    android:layout_weight="2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completion Tag"
                    android:buttonTint="@color/blue_shade_one"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/black_shade_two"
                    android:layout_marginStart="@dimen/margin_16" />

            </RadioGroup>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_shade_six"
                android:layout_marginTop="@dimen/margin_12"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_trailer_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_shade_six"
                android:layout_marginBottom="@dimen/margin_12"/>
            <RadioGroup
                android:id="@+id/rg_trailer_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/margin_16"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rb_near_tag_trailer"
                    android:layout_weight=".5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/near_tag"
                    android:buttonTint="@color/blue_shade_one"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/black_shade_two"
                    android:layout_marginStart="@dimen/margin_16" />
                <RadioButton
                    android:id="@+id/rb_off_tag_trailer"
                    android:layout_weight="1.5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/off_tag"
                    android:buttonTint="@color/blue_shade_one"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/black_shade_two"
                    android:layout_marginStart="@dimen/margin_16" />
            </RadioGroup>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_shade_six"
                android:layout_marginTop="@dimen/margin_12"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_current_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_16sp"
            android:textColor="@color/black_shade_two"
            android:paddingStart="@dimen/margin_40"
            android:layout_marginTop="@dimen/margin_16"/>
        <LinearLayout
            android:id="@+id/ll_tag_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nfc_bg_focus"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24"
            android:layout_marginTop="@dimen/margin_32">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/margin_16"
                android:paddingStart="@dimen/margin_32"
                android:paddingBottom="@dimen/margin_16"
                android:layout_weight="2">
                <TextView
                    android:id="@+id/tv_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tag ID"
                    android:textSize="@dimen/text_size_14sp"
                    android:textColor="@color/black_shade_two"/>

            </LinearLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/grey_shade_one">
            </View>
            <ImageView
                android:id="@+id/iv_nfcTag_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/nfc"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_tag_two"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nfc_bg_focus"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginEnd="@dimen/margin_24"
            android:layout_marginTop="@dimen/margin_32">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/margin_16"
                android:paddingStart="@dimen/margin_32"
                android:paddingBottom="@dimen/margin_16"
                android:layout_weight="2">
                <TextView
                    android:id="@+id/tv_tag_confirmation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Tag ID"
                    android:textSize="@dimen/text_size_14sp"
                    android:textColor="@color/black_shade_two"/>

            </LinearLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/grey_shade_one">
            </View>
            <ImageView
                android:id="@+id/iv_nfcTag_two"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/nfc"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_32"
            android:layout_marginLeft="@dimen/margin_24"
            android:layout_marginRight="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_24">
            <Button
            android:id="@+id/bt_discard"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/login_button_background"
            android:padding="@dimen/input_field_padding"
            android:text="Discard"
            android:layout_marginEnd="@dimen/margin_8"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/input_text_size"/>
            <Button
            android:id="@+id/bt_save_nfc"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/login_button_background"
            android:padding="@dimen/input_field_padding"
            android:text="Save &amp; Submit"
                android:layout_marginStart="@dimen/margin_8"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/input_text_size" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
