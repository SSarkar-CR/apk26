<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/text_size_14sp"
    android:paddingRight="14dp"
    android:paddingTop="@dimen/margin_18"
    android:paddingBottom="@dimen/margin_18"
   >
   <!-- android:background="@color/transparent"-->
    <com.crate.crateam.utility.CustomSearchableSpinner
        android:id="@+id/sp_hour"
        android:layout_width="90dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sp_minute"
        android:layout_height="wrap_content"
        android:background="@drawable/spinner_bg"
        android:popupBackground="@color/white"
        android:paddingStart="@dimen/margin_2"
        android:paddingEnd="@dimen/margin_16"
        android:layout_marginTop="@dimen/margin_12"
        app:hintText="HH"
        android:dropDownVerticalOffset="100dp"
        android:theme="@style/spinnerTheme"
        android:visibility="gone"/>
    <com.crate.crateam.utility.CustomSearchableSpinner
        android:id="@+id/sp_minute"
        android:layout_width="90dp"
        app:layout_constraintStart_toEndOf="@+id/sp_hour"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spinner_bg"
        android:popupBackground="@color/white"
        android:paddingStart="@dimen/margin_2"
        android:paddingEnd="@dimen/margin_16"
        android:layout_marginTop="@dimen/margin_12"
        app:hintText="MM"
        android:dropDownVerticalOffset="100dp"
        android:theme="@style/spinnerTheme"
        android:visibility="gone"/>
    <Button
        android:id="@+id/bt_ok"
        android:layout_width="90dp"
        android:layout_height="44dp"
        app:layout_constraintStart_toStartOf="@id/rv_hour"
        app:layout_constraintEnd_toEndOf="@id/rv_hour"
        app:layout_constraintTop_toBottomOf="@+id/rv_hour"
        android:layout_marginTop="@dimen/margin_24"

        android:layout_marginBottom="24dp"
        android:text="Ok"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:padding="4dp"
        android:textSize="@dimen/input_text_size"
        android:background="@drawable/login_button_background"/>
    <Button
        android:id="@+id/bt_cancel_waiting"
        android:layout_width="90dp"
        android:layout_height="44dp"
        app:layout_constraintStart_toStartOf="@id/rv_minute"
        app:layout_constraintEnd_toEndOf="@id/rv_minute"
        app:layout_constraintTop_toBottomOf="@id/rv_minute"
        android:layout_marginTop="@dimen/margin_24"
        android:layout_marginBottom="24dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:padding="4dp"
        android:textSize="@dimen/input_text_size"
        android:background="@drawable/login_button_background"/>
    <TextView
        android:id="@+id/tv_text_hour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@+id/rv_hour"
        app:layout_constraintEnd_toEndOf="@id/rv_hour"
        android:text="HH"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:padding="@dimen/margin_4"/>
    <TextView
        android:id="@+id/tv_text_minute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@+id/rv_minute"
        app:layout_constraintEnd_toEndOf="@+id/rv_minute"
        android:text="MM"
        android:textSize="16sp"

        android:textColor="@color/white"
        android:padding="@dimen/margin_4"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_hour"
        android:layout_width="0dp"
        android:layout_height="250dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_text_hour"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_toEndOf="@id/rv_minute"
        app:layout_constraintEnd_toStartOf="@+id/rv_minute"
        android:layout_marginRight="@dimen/margin_12"
        android:layout_marginTop="@dimen/margin_12">
    </androidx.recyclerview.widget.RecyclerView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_minute"
        android:layout_width="0dp"
        android:layout_height="250dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_text_minute"
        app:layout_constraintStart_toEndOf="@id/rv_hour"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginLeft="@dimen/margin_12"
        android:layout_marginTop="@dimen/margin_12">
    </androidx.recyclerview.widget.RecyclerView>
</androidx.constraintlayout.widget.ConstraintLayout>