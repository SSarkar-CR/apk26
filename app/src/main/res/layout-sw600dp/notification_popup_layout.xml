<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:layout_margin="@dimen/margin_24"
        android:background="@drawable/nfc_background">
        <TextView
            android:id="@+id/tv_change_pass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification Message"
            android:textColor="@color/black_shade_two"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/margin_16"
            android:textSize="@dimen/text_size_16sp"
            android:gravity="center_horizontal"/>
        <Button
            android:id="@+id/bt_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_48"
            android:layout_marginEnd="@dimen/margin_48"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_32"
            android:background="@drawable/login_button_background"
            android:text="OK"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:padding="@dimen/input_field_padding"
            android:textSize="@dimen/input_text_size" />

    </LinearLayout>



</LinearLayout>
