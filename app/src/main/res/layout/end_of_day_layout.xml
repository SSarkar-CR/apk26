                <View
                    android:id="@+id/view_odometer_reading"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_liters_filled"
                    app:layout_constraintBottom_toTopOf="@+id/cl_odometer_reading"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:background="@color/grey_shade_one"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_odometer_reading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_odometer_reading"
                    android:layout_marginTop="0dp"
                    android:background="@color/white"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_odometer_reading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/et_odometer_reading"
                            android:text="Current odometer reading:"
                            android:textSize="16sp"
                            android:layout_marginRight="5dp"
                            android:textColor="@color/black_shade_two"
                            android:layout_marginStart="@dimen/margin_24"/>
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/et_odometer_reading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            app:layout_constraintStart_toEndOf="@+id/tv_odometer_reading"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:maxLines="1"
                            android:maxLength="15"
                            android:inputType="numberDecimal"
                            android:layout_marginRight="5dp"
                            android:padding="@dimen/margin_8"
                            android:background="@drawable/edit_text_background"
                            android:textColor="@color/black_shade_two"
                            android:layout_marginEnd="@dimen/margin_24"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/view_comment"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_odometer_reading"
                    app:layout_constraintBottom_toTopOf="@+id/cl_comment"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:background="@color/grey_shade_one"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_comment"
                    android:layout_marginTop="0dp"
                    android:background="@color/white"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_comment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/et_comment"
                            android:text="Comment:"
                            android:textSize="16sp"
                            android:layout_marginEnd="5dp"
                            android:textColor="@color/black_shade_two"
                            android:layout_marginStart="@dimen/margin_24"/>
                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/et_comment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            app:layout_constraintStart_toEndOf="@+id/tv_comment"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:minLines="4"
                            android:gravity="top|left"
                            android:layout_marginRight="5dp"
                            android:padding="@dimen/margin_8"
                            android:background="@drawable/edit_text_background"
                            android:textColor="@color/black_shade_two"
                            android:layout_marginEnd="@dimen/margin_24"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_comment"
                    android:background="@color/background_color_one">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt_continue_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="@dimen/margin_24"
                    android:layout_marginBottom="@dimen/margin_18"
                    android:background="@drawable/nfc_background_select"
                    android:text="@string/continue_day"
                    android:textAllCaps="false"
                    android:textColor="@color/blue_shade_one"
                    android:padding="@dimen/input_field_padding"
                    android:textSize="@dimen/input_text_size"
                    android:layout_marginStart="@dimen/margin_24"
                    android:layout_marginEnd="@dimen/margin_24"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt_close"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bt_continue_day"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginTop="@dimen/margin_24"
                    android:layout_marginBottom="@dimen/margin_18"
                    android:background="@drawable/edit_text_background"
                    android:text="@string/close"
                    android:textAllCaps="false"
                    android:textColor="@color/black_shade_two"
                    android:padding="@dimen/input_field_padding"
                    android:textSize="@dimen/input_text_size"
                    android:layout_marginStart="@dimen/margin_24"
                    android:layout_marginEnd="@dimen/margin_24"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt_finish_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_continue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginTop="@dimen/margin_24"
