<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/margin_12"
    android:layout_marginRight="@dimen/margin_12"
    android:layout_marginBottom="@dimen/margin_4"
    android:orientation="vertical"
    android:background="@drawable/defected_vehicle_bg">

    <LinearLayout
        android:id="@+id/ll_issue"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height_other"
        android:gravity="center"
        android:layout_margin="@dimen/margin_6"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_4"
            android:layout_gravity="top"
            android:layout_weight="1.5"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/margin_4"
                android:text="Inspection Id"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_inspection_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="6"
                android:layout_marginBottom="@dimen/margin_10"
                android:paddingStart="@dimen/margin_2"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_4"
            android:layout_weight="1"
            android:layout_gravity="top"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/margin_4"
                android:text="Date"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="8"
                android:layout_marginBottom="@dimen/margin_10"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_4"
            android:layout_weight="1"
            android:layout_gravity="top"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/margin_4"
                android:text="Raised By"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_raised_by"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="5"
                android:layout_marginBottom="@dimen/margin_10"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_view_issue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/view"/>

    </LinearLayout>
</LinearLayout>
