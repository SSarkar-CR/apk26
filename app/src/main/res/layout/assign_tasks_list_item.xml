<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical|end"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="10dp"
            app:cardCornerRadius="8dp"
            android:layout_margin="5dp"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_color_one">
                <LinearLayout
                    android:id="@+id/ll_assign_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:background="@drawable/list_item_background"
                    android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/list_item_background">

                <ImageView
                    android:id="@+id/iv_car"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_8"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/car"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:layout_marginStart="@dimen/margin_4"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task Status"
                        android:textColor="@color/black_shade_three"
                        android:paddingBottom="@dimen/margin_4"
                        android:textSize="@dimen/text_size_14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tv_task_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:paddingStart="@dimen/margin_2"
                        android:ems="7"
                        android:textColor="@color/black_shade_two"
                        android:textSize="@dimen/text_size_12sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_8"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Material Name"
                        android:textColor="@color/black_shade_three"
                        android:paddingBottom="@dimen/margin_4"
                        android:textSize="@dimen/text_size_14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tv_material_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/black_shade_two"
                        android:textSize="@dimen/text_size_10sp"/>

                </LinearLayout>
               </LinearLayout>
                    <!-- second row-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/list_item_background">

                        <ImageView
                            android:id="@+id/iv_car1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_8"
                            android:layout_gravity="center_vertical"
                            android:visibility="invisible"
                            android:src="@drawable/car"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_8"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Collection Point"
                                android:textColor="@color/black_shade_three"
                                android:paddingBottom="@dimen/margin_4"
                                android:textSize="@dimen/text_size_14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tv_collection_point"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="@color/black_shade_two"
                                android:textSize="@dimen/text_size_10sp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_8"
                            android:layout_marginBottom="@dimen/margin_8"
                            android:layout_marginTop="@dimen/margin_8"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delivery Point"
                                android:textColor="@color/black_shade_three"
                                android:paddingBottom="@dimen/margin_4"
                                android:textSize="@dimen/text_size_14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tv_delivery_point"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="@color/black_shade_two"
                                android:textSize="@dimen/text_size_10sp"/>

                        </LinearLayout>
                    </LinearLayout>
                    <!-- third row-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/list_item_background">

                        <ImageView
                            android:id="@+id/iv_car2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_8"
                            android:layout_gravity="center_vertical"
                            android:visibility="invisible"
                            android:src="@drawable/car"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_8"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contact Name"
                                android:textColor="@color/black_shade_three"
                                android:paddingBottom="@dimen/margin_4"
                                android:textSize="@dimen/text_size_14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tv_contact_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="@color/black_shade_two"
                                android:textSize="@dimen/text_size_10sp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_8"
                            android:layout_marginBottom="@dimen/margin_8"
                            android:layout_marginTop="@dimen/margin_8"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comments"
                                android:textColor="@color/black_shade_three"
                                android:paddingBottom="@dimen/margin_4"
                                android:textSize="@dimen/text_size_14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tv_comments"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black_shade_two"
                                android:textSize="@dimen/text_size_10sp"/>

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>
</LinearLayout>

