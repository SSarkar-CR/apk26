<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_awaiting_delivery"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_shade_one"
    android:orientation="vertical"
    android:overScrollMode="never"
    android:fadingEdge="none">
    <LinearLayout
        android:id="@+id/ll_awaiting_delivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey_shade_one"
        android:paddingBottom="@dimen/header_height_dashboard"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/cl_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_dashboard"
            android:background="@color/white">
            <ImageView
                android:id="@+id/iv_cross"
                android:layout_width="@dimen/margin_16"
                android:layout_height="@dimen/margin_16"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_24"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/closed"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tv_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="34dp"
                android:text="Tickets Awaiting Delivery"
                android:textColor="@color/black_shade_five"
                android:textSize="@dimen/text_size_20sp"
                android:textStyle="bold" />
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_2"
            android:layout_marginTop="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/operator"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>
            <TextView
                android:layout_weight="2"
                android:id="@+id/tv_user"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Test User"
                android:textSize="@dimen/text_size_16sp"
                android:textColor="@color/black_shade_three" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_internal_reg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Reg No."
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"
                android:layout_gravity="center_vertical"/>

            <com.crate.crateam.utility.CustomSearchableSpinner
                android:id="@+id/sp_reg_no"
                android:layout_weight="2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_bg"
                android:popupBackground="@color/white"
                android:paddingStart="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_16"
                app:hintText="Select Reg No."
                android:dropDownVerticalOffset="100dp"
                android:theme="@style/spinnerTheme"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_trailer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Trailer No."
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"
                android:layout_gravity="center_vertical"/>

            <com.crate.crateam.utility.CustomSearchableSpinner
                android:id="@+id/sp_trailer_no"
                android:layout_weight="2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_bg"
                android:popupBackground="@color/white"
                android:paddingStart="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_16"
                app:hintText="Select Trailer No."
                android:dropDownVerticalOffset="100dp"
                android:theme="@style/spinnerTheme"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_awaiting_delivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_16"
            android:fadingEdge="none"
            android:overScrollMode="never">

        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
