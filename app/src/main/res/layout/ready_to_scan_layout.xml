<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@drawable/popup_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ready_to_scan"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/small_text_size"
            android:layout_margin="@dimen/margin_16"
            android:layout_gravity="center_horizontal"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ready_to_scan_nfc"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/margin_16"/>
<!--        <TextView-->
<!--            android:id="@+id/tv_message"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_gravity="center_horizontal"-->
<!--            android:textColor="@color/black"/>-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ready_to_scan_text"
            android:textColor="@color/black_shade_two"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"/>
        <Button
            android:id="@+id/bt_cancel_popup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_48"
            android:layout_marginEnd="@dimen/margin_48"
            android:layout_marginTop="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_32"
            android:background="@drawable/edit_text_background"
            android:text="Ok"
            android:textAllCaps="false"
            android:textColor="@color/black_shade_two"
            android:padding="@dimen/input_field_padding"
            android:textSize="@dimen/input_text_size" />

    </LinearLayout>



</LinearLayout>
