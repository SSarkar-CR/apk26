<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/margin_12"
    android:layout_marginRight="@dimen/margin_12"
    android:layout_marginBottom="@dimen/margin_4"
    android:orientation="vertical"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/rl_view_certificates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background_blue"
        android:layout_margin="@dimen/margin_8"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_24"
            android:src="@drawable/certificates" />

        <TextView
            android:id="@+id/tv_regime_element_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_toStartOf="@+id/iv_view"
            android:layout_toEndOf="@id/iv_date"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/margin_6"
            android:layout_marginEnd="@dimen/margin_24"
            android:src="@drawable/view" />
    </RelativeLayout>

</LinearLayout>
