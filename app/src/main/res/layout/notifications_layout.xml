<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color_one"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/no_notifications"
        android:layout_marginBottom="@dimen/margin_40"
        android:gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_notification"
        android:textColor="@color/black_shade_three"
        android:textSize="@dimen/extra_small_text_size"
        android:gravity="center_horizontal"/>
    <Button
        android:id="@+id/bt_view_dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/login_button_background"
        android:textAllCaps="false"
        android:layout_marginTop="@dimen/margin_24"
        android:layout_marginBottom="@dimen/margin_24"
        android:paddingStart="@dimen/margin_40"
        android:paddingEnd="@dimen/margin_40"
        android:textSize="@dimen/extra_small_text_size"
        android:text="@string/view_dashboard"/>

</LinearLayout>
