<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color_one"
    android:fadingEdge="none"
    android:orientation="vertical"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color_one"
        android:orientation="vertical"
        android:paddingBottom="@dimen/footer_height">

        <CheckBox
            android:id="@+id/cb_nfc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inspect vehicle without NFC scan ?"
            android:buttonTint="@color/blue_shade_one"
            android:textSize="@dimen/text_size_12sp"
            android:textColor="@color/black_shade_two"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_16"
            android:paddingStart="@dimen/margin_24"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"/>

        <com.crate.crateam.utility.CustomSearchableSpinner
            android:id="@+id/sp_reg_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_bg"
            android:popupBackground="@color/white"
            android:paddingStart="@dimen/margin_8"
            android:paddingEnd="@dimen/margin_16"
            android:layout_margin="@dimen/margin_16"
            app:hintText="Select Reg No"
            android:dropDownVerticalOffset="100dp"
            android:theme="@style/spinnerTheme"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:layout_marginBottom="@dimen/margin_2"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_24"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drivers_name"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp" />

            <TextView
                android:id="@+id/tv_driver_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@color/black_shade_three"
                android:textColorHint="@color/black_shade_three"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_2"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_24"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_no"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp" />

            <TextView
                android:id="@+id/tv_registration_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@color/black_shade_three"
                android:textColorHint="@color/black_shade_three"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_2"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_24"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fleet_serial_no"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp" />

            <TextView
                android:id="@+id/tv_fleet_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:inputType="textNoSuggestions"
                android:textColor="@color/black_shade_three"
                android:textColorHint="@color/black_shade_three"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_2"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_24"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manufacturer"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp" />

            <TextView
                android:id="@+id/tv_manufacturer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:inputType="textNoSuggestions"
                android:textColor="@color/black_shade_three"
                android:textColorHint="@color/black_shade_three"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_24"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp" />

            <TextView
                android:id="@+id/tv_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:inputType="textNoSuggestions"
                android:textColor="@color/black_shade_three"
                android:textColorHint="@color/black_shade_three"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_nfc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/margin_16"
                android:gravity="center"
                android:text="@string/nfc_tag_text_vehicle"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/extra_small_text_size" />

            <LinearLayout
                android:id="@+id/ll_tag1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_16"
                android:background="@drawable/nfc_bg_focus"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/front_tag"
                        android:textColor="@color/black_shade_three"
                        android:textSize="@dimen/text_size_16sp" />

                    <TextView
                        android:id="@+id/tv_front_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_16sp"
                        android:visibility="invisible" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_shade_one"></View>

                <ImageView
                    android:id="@+id/iv_nfcTag_front"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:src="@drawable/nfc" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_tag2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginEnd="@dimen/margin_16"
                android:background="@drawable/nfc_bg_focus"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/near_tag"
                        android:textColor="@color/black_shade_three"
                        android:textSize="@dimen/text_size_16sp" />

                    <TextView
                        android:id="@+id/tv_near_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_16sp"
                        android:visibility="invisible" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_shade_one"></View>

                <ImageView
                    android:id="@+id/iv_nfcTag_near"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:src="@drawable/nfc" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_tag3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_16"
                android:background="@drawable/nfc_bg_focus"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/off_tag"
                        android:textColor="@color/black_shade_three"
                        android:textSize="@dimen/text_size_16sp" />

                    <TextView
                        android:id="@+id/tv_off_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_16sp"
                        android:visibility="invisible" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_shade_one"></View>

                <ImageView
                    android:id="@+id/iv_nfcTag_off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:src="@drawable/nfc" />

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_arrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <ImageView
                android:id="@+id/iv_next_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/arrow"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_marginBottom="@dimen/margin_8"
                android:layout_marginEnd="@dimen/margin_24"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_next_page"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/margin_24"
                android:text="@string/next_page"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_14sp" />
        </RelativeLayout>

    </LinearLayout>
</ScrollView>
