<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sv_ad_hoc_report"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color_one"
    android:orientation="vertical"
    android:overScrollMode="never"
    android:fadingEdge="none">
    <LinearLayout
        android:id="@+id/ll_ad_hoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color_one"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/cl_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_dashboard"
            android:background="@color/white">
            <ImageView
                android:id="@+id/iv_cross"
                android:layout_width="@dimen/margin_20"
                android:layout_height="@dimen/margin_20"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_24"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/closed" />
            <TextView
                android:id="@+id/tv_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="34dp"
                android:layout_centerInParent="true"
                android:text="@string/start_task"
                android:textColor="@color/black_shade_five"
                android:textSize="@dimen/small_text_size"
                android:textStyle="bold" />
        </RelativeLayout>
        <!--  add layout-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Name :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>
            <TextView
                android:layout_weight="2"
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_16sp"
                android:textColor="@color/black_shade_three" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="User Role :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>
            <TextView
                android:layout_weight="2"
                android:id="@+id/tv_role"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_16sp"
                android:textColor="@color/black_shade_three" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Vehicle Number :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>
            <TextView
                android:layout_weight="2"
                android:id="@+id/tv_vehicle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_16sp"
                android:textColor="@color/black_shade_three" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_change_vehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Vehicle"
            android:background="@drawable/nfc_background_select"
            android:textSize="@dimen/text_size_16sp"
            android:textColor="@color/black_shade_two"
            android:padding="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/margin_24"
            android:drawableStart="@drawable/car"
            android:drawablePadding="@dimen/margin_4"
            android:visibility="gone"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_shade_two"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_16"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Task"
            android:textSize="@dimen/text_size_16sp"
            android:textColor="@color/black_shade_four"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_16"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/grey_shade_one"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/margin_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">
                    <TextView
                        android:layout_weight="1.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Collection Point :"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/black_shade_two"
                        android:textSize="@dimen/text_size_16sp"/>
                    <TextView
                        android:layout_weight="2"
                        android:id="@+id/tv_collection_point"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/black_shade_three" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">
                    <TextView
                        android:layout_weight="1.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Material :"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/black_shade_two"
                        android:textSize="@dimen/text_size_16sp"/>
                    <TextView
                        android:layout_weight="2"
                        android:id="@+id/tv_material"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/black_shade_three" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">
                    <TextView
                        android:layout_weight="1.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Delivery Point :"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/black_shade_two"
                        android:textSize="@dimen/text_size_16sp"/>
                    <TextView
                        android:layout_weight="2"
                        android:id="@+id/tv_delivery_point"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/black_shade_three" />
                </LinearLayout>
                <!--ticket type-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:paddingStart="@dimen/margin_16"
                    android:paddingEnd="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_12">
                    <TextView
                        android:layout_weight="1.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ticket Type :"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/black_shade_two"
                        android:textSize="@dimen/text_size_16sp"/>
                    <TextView
                        android:layout_weight="2"
                        android:id="@+id/tv_ticket_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/black_shade_three" />
                </LinearLayout>
                <Button
                    android:id="@+id/bt_start_task"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_24"
                    android:background="@drawable/login_button_background"
                    android:text="@string/start_task"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:padding="@dimen/input_field_padding"
                    android:textSize="@dimen/input_text_size" />
<!--                <LinearLayout-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginTop="@dimen/margin_24"-->
<!--                    android:background="@drawable/nfc_background_select"-->
<!--                    android:orientation="horizontal">-->
<!--                    <TextView-->
<!--                        android:id="@+id/tv_time"-->
<!--                        android:layout_weight="1"-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="match_parent"-->
<!--                        android:text="Time :"-->
<!--                        android:gravity="start|center"-->
<!--                        android:textSize="@dimen/text_size_16sp"-->
<!--                        android:textColor="@color/black_shade_three"-->
<!--                        android:drawableStart="@drawable/clock"-->
<!--                        android:drawablePadding="@dimen/margin_4"-->
<!--                        android:padding="@dimen/margin_12"/>-->
<!--                    <View-->
<!--                        android:layout_width="@dimen/margin_1"-->
<!--                        android:layout_height="match_parent"-->
<!--                        android:background="@color/grey_shade_two"/>-->
<!--                    <TextView-->
<!--                        android:id="@+id/tv_location"-->
<!--                        android:layout_weight="1.2"-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="GPS Location:"-->
<!--                        android:textSize="@dimen/text_size_16sp"-->
<!--                        android:textColor="@color/black_shade_three"-->
<!--                        android:drawableStart="@drawable/location"-->
<!--                        android:drawablePadding="@dimen/margin_4"-->
<!--                        android:padding="@dimen/margin_12"/>-->
<!--                </LinearLayout>-->
                <Button
                    android:id="@+id/bt_abort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_24"
                    android:layout_marginBottom="@dimen/margin_18"
                    android:background="@drawable/nfc_background_select"
                    android:text="Abort Task ?"
                    android:textAllCaps="false"
                    android:textColor="@color/black_shade_two"
                    android:padding="@dimen/input_field_padding"
                    android:textSize="@dimen/input_text_size" />
                <ImageView
                    android:id="@+id/iv_next_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_12"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:layout_gravity="end"/>
                <Button
                    android:id="@+id/bt_add_fuel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_24"
                    android:layout_marginBottom="@dimen/margin_18"
                    android:background="@drawable/grey_button_bg"
                    android:text="@string/end_of_day"
                    android:textAllCaps="false"
                    android:textColor="@color/black_shade_two"
                    android:padding="@dimen/input_field_padding"
                    android:textSize="@dimen/input_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
