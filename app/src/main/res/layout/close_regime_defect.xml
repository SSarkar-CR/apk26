<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_ad_hoc_report"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color_one"
    android:orientation="vertical"
    android:overScrollMode="never"
    android:fadingEdge="none">
    <LinearLayout
        android:id="@+id/ll_peeking_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color_one"
        android:paddingBottom="@dimen/header_height_dashboard"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/cl_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_dashboard"
            android:background="@color/white">

            <TextView
                android:id="@+id/tv_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="34dp"
                android:text="Defect Description and Resolution"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/small_text_size"
                android:textStyle="bold" />
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Asset Variant Name :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>

            <TextView
                android:id="@+id/tv_asset_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Test data"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Asset Id :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>

            <TextView
                android:id="@+id/tv_asset_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="0001"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Asset Name :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>

            <TextView
                android:id="@+id/tv_asset_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Testing Drill"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Defect Description :"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_16sp"
            android:background="@color/grey_shade_one"
            android:textColor="@color/black_shade_two"
            android:paddingStart="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingEnd="@dimen/margin_16"
            android:paddingBottom="@dimen/margin_12"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Safety Critical Name:"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>

            <TextView
                android:id="@+id/tv_element_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginBottom="@dimen/margin_2"
            android:visibility="visible">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Threshold Value:"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>

            <TextView
                android:id="@+id/tv_element_defect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Raised By :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>

            <TextView
                android:id="@+id/tv_inspected_by"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Defect Date :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_regime_element"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginBottom="@dimen/margin_2">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Threshold values will be changed for this Safety Critical values , so please update with care."
                android:textColor="@color/black_shade_four"
                android:drawableLeft="@drawable/caution_inspection_24"
                android:textSize="@dimen/text_size_16sp"
                android:gravity="center_horizontal"
                android:layout_margin="@dimen/margin_8"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Threshold Value:"
                android:textSize="@dimen/text_size_16sp"
                android:textColor="@color/black_shade_two"
                android:paddingStart="@dimen/margin_16"
                android:paddingTop="@dimen/margin_6"
                android:paddingEnd="@dimen/margin_6" />
            <EditText
                android:id="@+id/et_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:padding="5dp"
                android:inputType="number"
                android:layout_margin="@dimen/margin_10"
                android:gravity="top|left"
                android:background="@drawable/edit_text_background"
                android:textColor="@color/black_shade_three"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/tv_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_24"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_marginBottom="@dimen/margin_10"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"
                android:text="dd-mm-yyyy"
                android:textStyle="bold"
                android:visibility="gone"/>
            <RadioGroup
                android:id="@+id/rg_value_yes_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_24"
                android:layout_marginEnd="@dimen/margin_24"
                android:layout_marginTop="@dimen/margin_12"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/rb_yes"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Yes"
                    android:textSize="@dimen/text_size_16sp"
                    android:buttonTint="@color/blue_shade_one"
                    android:textColor="@color/black_shade_two"
                    android:layout_margin="@dimen/margin_8"/>
                <RadioButton
                    android:id="@+id/rb_no"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"
                    android:textSize="@dimen/text_size_16sp"
                    android:buttonTint="@color/blue_shade_one"
                    android:textColor="@color/black_shade_two"
                    android:layout_margin="@dimen/margin_8"/>
            </RadioGroup>
            <RadioGroup
                android:id="@+id/rg_value_on_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_24"
                android:layout_marginEnd="@dimen/margin_24"
                android:layout_marginTop="@dimen/margin_12"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/rb_on"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="On"
                    android:textSize="@dimen/text_size_16sp"
                    android:buttonTint="@color/blue_shade_one"
                    android:textColor="@color/black_shade_two"
                    android:layout_margin="@dimen/margin_8"/>
                <RadioButton
                    android:id="@+id/rb_off"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off"
                    android:textSize="@dimen/text_size_16sp"
                    android:buttonTint="@color/blue_shade_one"
                    android:textColor="@color/black_shade_two"
                    android:layout_margin="@dimen/margin_8"/>
            </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Add Comment:"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>
            <EditText
                android:id="@+id/et_comment"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="100dp"
                android:layout_marginLeft="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:padding="5dp"
                android:maxLength="20"
                android:gravity="top|left"
                android:layout_marginRight="0dp"
                android:background="@drawable/edit_text_background"
                android:textColor="@color/black_shade_three"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="@dimen/margin_16"
            android:paddingEnd="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingBottom="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_2">
            <TextView
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Capture a photo of asset for records :"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp"/>
            <ImageView
                android:layout_weight="2"
                android:id="@+id/iv_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/camera"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_images"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:orientation="horizontal"
            android:background="@color/white"
            android:visibility="gone">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_4"
                android:layout_weight="1"
                android:background="@drawable/camera_bg">
                <ImageView
                    android:id="@+id/iv_photo_one"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginEnd="@dimen/margin_4"
                    android:layout_marginStart="@dimen/margin_4"
                    android:layout_marginTop="@dimen/margin_4"
                    android:scaleType="fitXY"
                    android:src="@drawable/placeholder_image"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <ImageView
                    android:id="@+id/iv_close_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignEnd="@+id/iv_photo_one"
                    android:layout_marginEnd="-3dp"
                    app:srcCompat="@drawable/cross" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_photo_one"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="13dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="6dp"
                    android:text="Photo- 1"
                    android:textColor="@color/black_shade_two"
                    android:textSize="@dimen/text_size_12sp" />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_4"
                android:layout_weight="1"
                android:background="@drawable/camera_bg">
                <ImageView
                    android:id="@+id/iv_photo_two"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginEnd="@dimen/margin_4"
                    android:layout_marginStart="@dimen/margin_4"
                    android:layout_marginTop="@dimen/margin_4"
                    android:scaleType="fitXY"
                    android:src="@drawable/placeholder_image"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <ImageView
                    android:id="@+id/iv_close_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignEnd="@+id/iv_photo_two"
                    android:layout_marginEnd="-3dp"
                    app:srcCompat="@drawable/cross" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_photo_two"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="13dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="6dp"
                    android:text="Photo- 2"
                    android:textColor="@color/black_shade_two"
                    android:textSize="@dimen/text_size_12sp" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_2"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin_16"
            android:paddingTop="@dimen/margin_12"
            android:paddingEnd="@dimen/margin_16"
            android:paddingBottom="@dimen/margin_12">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.5"
                android:paddingEnd="@dimen/margin_12"
                android:text="Signature of inspector :"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_16sp" />

            <Button
                android:id="@+id/bt_inspector_sign"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:background="@drawable/blue_button_background"
                android:text="@string/sign_here"
                android:textAllCaps="false"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_inspector_sign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/nfc_background_select"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginEnd="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_8"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inspector Signature"
                android:background="@drawable/my_sign_bg"
                android:textColor="@color/blue_shade_one"
                android:gravity="center_horizontal"
                android:padding="@dimen/margin_12"/>
            <com.github.gcacace.signaturepad.views.SignaturePad
                android:id="@+id/signature_pad_inspector"
                android:layout_width="match_parent"
                android:layout_margin="@dimen/margin_4"
                android:layout_height="160dp"
                android:background="@drawable/nfc_background"
                app:penColor="@android:color/black" />
            <TextView
                android:id="@+id/tv_clear_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/nfc_bg_focus"
                android:text="Clear"
                android:layout_gravity="end"
                android:textAllCaps="false"
                android:textSize="@dimen/extra_small_text_size"
                android:paddingStart="@dimen/margin_8"
                android:paddingEnd="@dimen/margin_8"
                android:paddingTop="@dimen/margin_4"
                android:paddingBottom="@dimen/margin_4"
                android:layout_margin="@dimen/margin_8"
                android:textColor="@color/black_shade_three"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cb_defect_close_caution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:button="@drawable/check_box_selector"
            android:text="@string/defect_checkbox_caution"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16sp"
            android:layout_margin="@dimen/margin_8"/>
        <Button
            android:id="@+id/bt_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:layout_marginTop="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_18"
            android:background="@drawable/blue_button_background"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/black_shade_three"
            android:padding="@dimen/input_field_padding"
            android:textSize="@dimen/input_text_size" />
        <Button
            android:id="@+id/bt_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:layout_marginTop="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_18"
            android:background="@drawable/blue_button_background"
            android:text="Go Back"
            android:textAllCaps="false"
            android:textColor="@color/black_shade_three"
            android:padding="@dimen/input_field_padding"
            android:textSize="@dimen/input_text_size" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
