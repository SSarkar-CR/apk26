<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/margin_12"
    android:background="@color/transparent">
    <com.crate.crateam.utility.CustomSearchableSpinner
        android:id="@+id/sp_change_vehicle"
        android:layout_width="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spinner_bg"
        android:popupBackground="@color/white"
        android:paddingStart="@dimen/margin_2"
        android:paddingEnd="@dimen/margin_16"
        android:layout_marginTop="@dimen/margin_12"
        app:hintText="Select Vehicle "
        android:dropDownVerticalOffset="100dp"
        android:theme="@style/spinnerTheme"/>
    <Button
        android:id="@+id/bt_submit_new"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bt_exit"
        app:layout_constraintTop_toBottomOf="@+id/sp_change_vehicle"
        android:layout_marginTop="@dimen/margin_24"
        android:layout_marginRight="@dimen/margin_8"
        android:layout_marginBottom="24dp"
        android:text="Submit"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:padding="@dimen/input_field_padding"
        android:textSize="@dimen/input_text_size"
        android:onClick="getData"
        android:background="@drawable/login_button_background"/>
    <Button
        android:id="@+id/bt_exit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/bt_submit_new"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sp_change_vehicle"
        android:layout_marginTop="@dimen/margin_24"
        android:layout_marginLeft="@dimen/margin_8"
        android:layout_marginBottom="24dp"
        android:text="Exit"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:padding="@dimen/input_field_padding"
        android:textSize="@dimen/input_text_size"
        android:background="@drawable/login_button_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>