<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@drawable/popup_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/end_of_day_dialog"
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/small_text_size"
            android:layout_margin="@dimen/margin_24"
            android:layout_gravity="center_horizontal"/>
        <Button
            android:id="@+id/bt_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_48"
            android:layout_marginEnd="@dimen/margin_48"
            android:layout_marginTop="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_24"
            android:background="@drawable/login_button_background"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:padding="@dimen/input_field_padding"
            android:textSize="@dimen/input_text_size" />

        <Button
            android:id="@+id/bt_end_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_48"
            android:layout_marginEnd="@dimen/margin_48"
            android:layout_marginTop="@dimen/margin_24"
            android:layout_marginBottom="@dimen/margin_32"
            android:background="@drawable/login_button_background"
            android:text="End Your Day"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:padding="@dimen/input_field_padding"
            android:textSize="@dimen/input_text_size" />

    </LinearLayout>



</LinearLayout>