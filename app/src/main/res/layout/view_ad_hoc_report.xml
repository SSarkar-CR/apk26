<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/footer_height"
    android:overScrollMode="never"
    android:fadingEdge="none"
    android:background="@color/background_color_one">
  <LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
     <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       android:layout_marginTop="@dimen/margin_16"
       android:layout_marginBottom="@dimen/margin_1">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="@dimen/margin_12">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report ID."
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp" />
            <TextView
                android:id="@+id/tv_report_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_12sp" />
        </LinearLayout>
        <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="@dimen/margin_12"
        android:layout_marginStart="1dp"
        android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date/Time."
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp"/>
            <TextView
                android:id="@+id/tv_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_12sp"
                android:textStyle="bold" />
        </LinearLayout>
     </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_1"
        android:weightSum="2">
       <LinearLayout
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:background="@color/white"
         android:padding="@dimen/margin_12"
         android:layout_weight="1">
         <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver's Name."
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_12sp"/>
         <TextView
            android:id="@+id/tv_driver_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/black_shade_three"
            android:textSize="@dimen/text_size_12sp"/>
       </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:background="@color/white"
          android:padding="@dimen/margin_12"
          android:layout_marginStart="@dimen/margin_1"
          android:layout_weight="1">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NFC Tag Scanned."
            android:textColor="@color/black_shade_two"
            android:textSize="@dimen/text_size_12sp"/>
          <TextView
            android:id="@+id/tv_nfc_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/black_shade_three"
            android:textSize="@dimen/text_size_12sp"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_1"
        android:weightSum="2">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="@dimen/margin_12"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_no"
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp"/>
            <TextView
                android:id="@+id/tv_vehicle_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="@dimen/margin_12"
            android:layout_marginStart="@dimen/margin_1"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trailer/Fleet Serial No."
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp"/>
            <TextView
                android:id="@+id/tv_trailer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_12sp"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_1"
        android:weightSum="2">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="@dimen/margin_12"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manufacturer."
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp"/>
            <TextView
                android:id="@+id/tv_manufacturer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="@dimen/margin_12"
            android:layout_marginStart="@dimen/margin_1"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model."
                android:textColor="@color/black_shade_two"
                android:textSize="@dimen/text_size_12sp"/>
            <TextView
                android:id="@+id/tv_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/black_shade_three"
                android:textSize="@dimen/text_size_12sp"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:background="@drawable/nfc_background"
          android:layout_marginStart="@dimen/margin_12"
          android:layout_marginEnd="@dimen/margin_12"
          android:layout_marginTop="@dimen/margin_16">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_horizontal"
              android:padding="@dimen/margin_12"
              android:text="@string/driver_signature"
              android:textColor="@color/black_shade_three" />
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/grey_shade_one" />
          <ImageView
              android:id="@+id/iv_driver_sign"
              android:layout_width="match_parent"
              android:layout_margin="@dimen/margin_4"
              android:layout_height="180dp" />
      </LinearLayout>
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv_ad_hoc_defects"
          android:layout_width="match_parent"
          android:layout_height="match_parent" />
      <Button
          android:id="@+id/bt_add_signature"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="@dimen/margin_32"
          android:background="@drawable/login_button_background"
          android:padding="@dimen/input_field_padding"
          android:text="Add Signature"
          android:textAllCaps="false"
          android:visibility="gone"
          android:textColor="@color/white"
          android:textSize="@dimen/input_text_size" />
      <LinearLayout
          android:id="@+id/ll_manager_sign"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginTop="@dimen/margin_12"
          android:visibility="gone">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/nfc_background_select"
              android:layout_marginStart="@dimen/margin_16"
              android:layout_marginEnd="@dimen/margin_16"
              android:layout_marginBottom="@dimen/margin_16">
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/manager_signature"
                  android:background="@drawable/my_sign_bg"
                  android:textColor="@color/blue_shade_one"
                  android:gravity="center_horizontal"
                  android:padding="@dimen/margin_12"/>

              <com.github.gcacace.signaturepad.views.SignaturePad
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  android:id="@+id/signature_manager"
                  android:layout_width="match_parent"
                  android:layout_margin="@dimen/margin_4"
                  android:layout_height="150dp"
                  app:penColor="@android:color/black" />
          </LinearLayout>
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:layout_gravity="center_vertical"
              android:gravity="end">
              <TextView
                  android:id="@+id/tv_clear"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:background="@drawable/nfc_bg_focus"
                  android:text="Clear"
                  android:layout_gravity="end"
                  android:textAllCaps="false"
                  android:textSize="@dimen/extra_small_text_size"
                  android:paddingStart="@dimen/margin_8"
                  android:paddingEnd="@dimen/margin_8"
                  android:paddingTop="@dimen/margin_4"
                  android:paddingBottom="@dimen/margin_4"
                  android:layout_marginEnd="@dimen/margin_12"
                  android:textColor="@color/black_shade_three"/>
          </LinearLayout>
          <Button
              android:id="@+id/bt_submit_resolution"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@drawable/login_button_background"
              android:text="Submit"
              android:layout_margin="@dimen/margin_16"
              android:textAllCaps="false"
              android:textColor="@color/white"
              android:padding="@dimen/input_field_padding"
              android:textSize="@dimen/input_text_size" />
      </LinearLayout>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>