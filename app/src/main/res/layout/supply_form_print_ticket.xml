                        android:textSize="16dp"
                        android:textColor="@color/black_shade_seven"
                        android:padding="2dp"
                        android:layout_marginLeft="@dimen/margin_6"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
