                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_1"
                android:background="@color/black"
                android:layout_marginTop="@dimen/margin_2"/>

               <!-- haulier transferee-->
            <androidx.appcompat.widget.AppCompatTextView
